{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Selecionar identidade Git",
      "type": "shell",
      "command": "bash",
      "args": ["${workspaceFolder}/setup/configura_git.sh"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "close": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
